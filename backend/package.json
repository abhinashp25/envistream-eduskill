    "groq-sdk": "^0.7.0",
    "helmet": "^8.3.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "streamifier": "^0.1.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "eslint": "^9.9.0",
